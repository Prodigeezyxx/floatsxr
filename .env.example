# Floats — quote email stack (.env.example)
# Copy to .env for local dev; for production, set these in the
# Cloudflare Pages dashboard (Settings > Environment variables).
#
# Required — set BEFORE launch:
#   RESEND_API_KEY                   (Resend: resend.com/api-keys — mark as secret in Pages)
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY   (Cloudflare: Turnstile widget site key)
#   TURNSTILE_SECRET                 (Cloudflare: Turnstile widget secret — mark as secret)
#
# Optional:
#   RESEND_FROM                      e.g. "Floats <quotes@floatsanywhere.com>"
#   TEAM_EMAIL                       defaults to hello@floatsanywhere.com

RESEND_API_KEY=re_xxxxxxxx
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAxxxxxxxxxxxxxxxx
TURNSTILE_SECRET=0x4AAAAxxxxxxxxxxxxxxxx
RESEND_FROM="Floats <quotes@floatsanywhere.com>"
TEAM_EMAIL=hello@floatsanywhere.com